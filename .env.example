# ShieldWall runtime configuration (copy to .env)
SHIELD_MODE=on            # on = block | detect = log only | off = unprotected baseline
HTTP_PORT=8080
HTTPS_PORT=8443
SENTINEL_PORT=9000
PARANOIA=2                # OWASP CRS paranoia level (1-4)
INBOUND_THRESHOLD=5       # CRS inbound anomaly score threshold
LOGIN_RATE=5r/m           # nginx rate for login/reset endpoints
LOGIN_BURST=5
GENERAL_RATE=50r/s
GENERAL_BURST=200
BAN_STRIKES=20            # strikes inside STRIKE_WINDOW before auto-ban
STRIKE_WINDOW=120
BAN_STEPS=300,1800,86400  # escalating ban seconds: 5 min, 30 min, 24 h
ALLOWLIST=127.0.0.1,::1,172.28.0.1
SENTINEL_TOKEN=           # optional: required as X-Token for POST /api/unban
