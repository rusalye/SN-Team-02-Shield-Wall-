user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/shield/nginx_error.log warn;
include /etc/nginx/modules-enabled/*.conf;

events { worker_connections 2048; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    more_clear_headers Server;
    sendfile on;
    keepalive_timeout 30s;

    # --- Slowloris / oversized request hardening ---
    client_max_body_size    1m;
    client_body_timeout     10s;
    client_header_timeout   10s;
    send_timeout            15s;
    large_client_header_buffers 4 8k;

    # --- Structured access log, consumed by Sentinel ---
    log_format shield escape=json
      '{"ts":"$time_iso8601","ip":"$remote_addr","method":"$request_method","uri":"$request_uri",'
      '"status":$status,"rid":"$request_id","ua":"$http_user_agent","bytes":$body_bytes_sent,'
      '"rt":$request_time,"shield":"$sent_http_x_shield_action"}';
    access_log /var/log/shield/access.json shield;

    # --- Rate limiting (dry-run in detect/off modes) ---
    limit_req_zone  $binary_remote_addr zone=login:10m   rate=${LOGIN_RATE};
    limit_req_zone  $binary_remote_addr zone=general:10m rate=${GENERAL_RATE};
    limit_conn_zone $binary_remote_addr zone=perip:10m;
    limit_req_status  429;
    limit_conn_status 429;
    limit_req_dry_run ${RATE_DRY_RUN};

    # --- Dynamic IP blocklist, rewritten by Sentinel, applied via SIGHUP ---
    geo $shield_blocked {
        default 0;
        include /etc/nginx/dynamic/blocklist.conf;
    }
    map $shield_blocked $shield_reason { 1 "blocked-ip"; default "blocked-waf"; }
    map $http_upgrade   $connection_upgrade { default upgrade; "" ""; }

    upstream app_backend {
        server ${UPSTREAM};
        keepalive 32;
    }

    server {
        listen 80 default_server;
        server_name _;
        location = /healthz { access_log off; return 200 "ok\n"; }
        location /          { return 308 https://$host:${HTTPS_PUBLIC_PORT}$request_uri; }
    }

    server {
        listen 443 ssl http2 default_server;
        server_name ${SERVER_NAME} _;

        # --- TLS termination: modern protocols and AEAD ciphers only ---
        ssl_certificate     /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        # --- Security headers ---
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy        "geolocation=(), camera=(), microphone=()" always;

        # --- WAF: ModSecurity v3 + OWASP CRS ---
        modsecurity on;
        modsecurity_rules_file /etc/nginx/modsec/main.conf;

        # Auto-banned IPs are rejected before any rule runs.
        if ($shield_blocked) { return 403; }

        error_page 403 @blocked;
        error_page 429 @ratelimited;

        location @blocked {
            modsecurity off;
            default_type application/json;
            add_header X-Shield-Action $shield_reason always;
            add_header X-Request-ID    $request_id always;
            return 403 '{"error":"request blocked","by":"ShieldWall","request_id":"$request_id"}';
        }
        location @ratelimited {
            modsecurity off;
            default_type application/json;
            add_header X-Shield-Action "rate-limited" always;
            add_header Retry-After 12 always;
            return 429 '{"error":"too many requests","by":"ShieldWall","request_id":"$request_id"}';
        }

        # Credential endpoints: strict per-IP rate limit (brute-force control).
        location ~ ^/rest/user/(login|reset-password)$ {
            limit_req zone=login burst=${LOGIN_BURST} nodelay;
            include /etc/nginx/snippets/proxy_common.conf;
            proxy_pass http://app_backend;
        }

        location / {
            limit_req  zone=general burst=${GENERAL_BURST} nodelay;
            limit_conn perip 100;
            include /etc/nginx/snippets/proxy_common.conf;
            proxy_pass http://app_backend;
        }
    }
}
